#!/bin/bash
set -euxo pipefail

dnf install -y docker
systemctl enable --now docker

cat > /usr/local/bin/deploy-worker.sh <<'DEPLOY'
#!/bin/bash
# Usage: deploy-worker.sh <image-tag>
set -euo pipefail

TAG="$${1:-}"
REGION="${region}"
REPO_URL="${repo_url}"
REGISTRY="$${REPO_URL%%/*}"

param() {
  aws ssm get-parameter --region "$REGION" --with-decryption --name "$1" --query Parameter.Value --output text
}

if [ -z "$TAG" ]; then
  TAG=$(param ${param_prefix}/image_tag)
fi

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$REPO_URL:$TAG"

ENV_FILE=$(mktemp)
chmod 600 "$ENV_FILE"
{
  echo "DATABASE_URL=$(param ${param_prefix}/database_url)"
  echo "REDIS_URL=$(param ${param_prefix}/redis_url)"
  echo "CACHE_ENABLED=$(param ${param_prefix}/cache_enabled)"
  echo "CACHE_TTL_SECONDS=$(param ${param_prefix}/cache_ttl_seconds)"
  echo "SQS_QUEUE_URL=$(param ${param_prefix}/sqs_queue_url)"
  echo "AWS_REGION=$REGION"
} > "$ENV_FILE"

docker rm -f worker 2>/dev/null || true
docker run -d --name worker --restart always --stop-timeout 30 \
  --env-file "$ENV_FILE" \
  --log-driver awslogs \
  --log-opt awslogs-region="$REGION" \
  --log-opt awslogs-group="${log_group}" \
  "$REPO_URL:$TAG" \
  python worker.py
rm -f "$ENV_FILE"

echo "Worker deployed $REPO_URL:$TAG"
DEPLOY
chmod +x /usr/local/bin/deploy-worker.sh

TAG=$(aws ssm get-parameter --region "${region}" --name "${param_prefix}/image_tag" --query Parameter.Value --output text || echo latest)
/usr/local/bin/deploy-worker.sh "$TAG" || echo "No image in ECR yet, waiting for CI deploy"
